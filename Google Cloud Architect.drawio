        </mxCell>
        <mxCell id="mZOz6Scr3c5H25clqlI8-6" parent="1" style="text;whiteSpace=wrap;html=1;" value="gcloud compute ssh app-vm-1 \&#xd;&#xa;    --zone=us-central1-a \&#xd;&#xa;    --tunnel-through-iap \&#xd;&#xa;    --project=cymbal-retail-staging" vertex="1">
          <mxGeometry height="151.1" width="461" x="1863" y="482" as="geometry" />
