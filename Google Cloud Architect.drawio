        <mxCell id="mZOz6Scr3c5H25clqlI8-7" parent="1" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;perimeter=cloudPerimeter;" value="app-Vm-1 is my vm name I had slected zone given here while creating vm, tunnel was setup during vpc setup, project name was given before evrything else" vertex="1">
          <mxGeometry height="230" width="395" x="2060" y="411" as="geometry" />
        </mxCell>
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    subgraph ADMIN_FLOW [\&quot;1. Human / Deployer Identity\&quot;]\n        USER[\&quot;Admin / Developer Account\\n(e.g., user@domain.com)\&quot;]\n    end\n\n    subgraph SA_RESOURCE [\&quot;2. The Service Account (As a Resource)\&quot;]\n        SA[\&quot;Dedicated Runtime Service Account\\n`sa-cymbal-app@cymbal-retail-staging...`\\n(Starts with ZERO permissions)\&quot;]\n    end\n\n    subgraph IAM_BINDINGS [\&quot;3. Least-Privilege Role Bindings\&quot;]\n        ROLE_USER[\&quot;`roles/iam.serviceAccountUser`\\n(Allows Admin to attach SA to VM)\&quot;]\n        ROLE_TOKEN[\&quot;`roles/iam.serviceAccountTokenCreator`\\n(Allows Admin to mint short-lived tokens)\&quot;]\n        ROLE_LOG[\&quot;`roles/logging.logWriter`\\n(Allows VM to send logs)\&quot;]\n        ROLE_MON[\&quot;`roles/monitoring.metricWriter`\\n(Allows VM to publish metrics)\&quot;]\n    end\n\n    subgraph WORKLOAD [\&quot;4. Target Workload\&quot;]\n        VM[\&quot;Compute Engine VM: `app-vm-1`\\n(Runs with SA identity; no personal keys)\&quot;]\n    end\n\n    %% Relations\n    USER -- \&quot;Bound via SA IAM Policy\&quot; --&gt; ROLE_USER\n    USER -- \&quot;Bound via SA IAM Policy\&quot; --&gt; ROLE_TOKEN\n    ROLE_USER -.-&gt; SA\n    ROLE_TOKEN -.-&gt; SA\n\n    SA -- \&quot;Project IAM Binding\&quot; --&gt; ROLE_LOG\n    SA -- \&quot;Project IAM Binding\&quot; --&gt; ROLE_MON\n\n    SA ==&gt;|\&quot;Attached as execution identity\&quot;| VM&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="mZOz6Scr3c5H25clqlI8-8">
