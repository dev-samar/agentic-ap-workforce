  <diagram id="fZhIyRpkKVlG2B1rmW6q" name="Pattern 2 Cascading Resiliency (Cheap-to-Expensive LLM/API Call)">
    <mxGraphModel dx="2470" dy="1120" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    autonumber\n    actor Agent as Autonomous Agent / Worker\n    participant MW as Middleware Router\n    participant Cache as Cache Layer\n    participant LocalModel as Self-Hosted / Cheap Model\n    participant PremiumAPI as Premium External Vendor API\n\n    Agent-&gt;&gt;MW: Process Complex Document / Invoice Response\n    \n    %% Step 1: Idempotency &amp; De-duplication Check\n    MW-&gt;&gt;Cache: Check Transaction Hash ID\n    alt Request Already Processed\n        Cache--&gt;&gt;MW: Return Existing Output Payload\n        MW--&gt;&gt;Agent: Return Standardized Response (Cost = $0)\n    else New Request\n        %% Step 2: Route to Cost-Effective Tier First\n        MW-&gt;&gt;LocalModel: Attempt Local Extraction / Deterministic Parsing\n        alt Extraction High Confidence (Threshold &gt;= 95%)\n            LocalModel--&gt;&gt;MW: Return Successful Output\n            MW-&gt;&gt;Cache: Cache Result\n            MW--&gt;&gt;Agent: Return Output\n        else Low Confidence / Edge Case Detected (Fallback Triggered)\n            %% Step 3: Escalate to Premium External Engine\n            MW-&gt;&gt;MW: Generate Vendor Auth Token\n            MW-&gt;&gt;PremiumAPI: Route to Premium Model (Expensive Transaction)\n            PremiumAPI--&gt;&gt;MW: Return Rich Content Data Structure\n            MW-&gt;&gt;Cache: Cache Result\n            MW--&gt;&gt;Agent: Return Final Standardized Output\n        end\n    end&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="sg1AWymZiD_FHze2_abD-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Autonomous Agent / Worker" mermaidId="n:Agent" mermaidBaseStyle="html=1;shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;edgeStyle&quot;:&quot;sequenceEdgeStyle&quot;,&quot;libavoidRouting&quot;:0,&quot;curved&quot;:0,&quot;rounded&quot;:0};lifelineDashed=0;strokeWidth=2;rounded=1;absoluteArcSize=1;arcSize=12;lifelineColor=#28253D;fillColor=#FDF4FF;strokeColor=#E879F9;fontColor=#28253D;participant=seqActorStick;verticalAlign=bottom;align=center;spacingBottom=4;size=90;lifelineMirror=1;fontFamily=Recursive;fontSize=16;shadow=1;shadowColor=#000000;shadowOffsetX=4;shadowOffsetY=4;shadowBlur=0;shadowOpacity=6;" mermaidBaseValue="Autonomous Agent / Worker" id="sg1AWymZiD_FHze2_abD-2">
          <mxCell parent="sg1AWymZiD_FHze2_abD-1" style="html=1;shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;edgeStyle&quot;:&quot;sequenceEdgeStyle&quot;,&quot;libavoidRouting&quot;:0,&quot;curved&quot;:0,&quot;rounded&quot;:0};lifelineDashed=0;strokeWidth=2;rounded=1;absoluteArcSize=1;arcSize=12;lifelineColor=#28253D;fillColor=#FDF4FF;strokeColor=#E879F9;fontColor=#28253D;participant=seqActorStick;verticalAlign=bottom;align=center;spacingBottom=4;size=90;lifelineMirror=1;fontFamily=Recursive;fontSize=16;shadow=1;shadowColor=#000000;shadowOffsetX=4;shadowOffsetY=4;shadowBlur=0;shadowOpacity=6;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DRecursive;" vertex="1">
            <mxGeometry height="1011" width="230" x="30" y="30" as="geometry" />
