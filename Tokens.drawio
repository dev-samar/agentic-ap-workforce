  <diagram name="Page-1" id="q3mcuvrzdeSdRK03YW-g">
    <mxGraphModel dx="1933" dy="877" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    autonumber\n    actor Caller as Bot / Frontend Client\n    participant MW as Middleware Layer\n    participant Cache as Redis / In-Memory Cache\n    participant Auth as Identity Provider (IdP)\n    participant Legacy as Downstream Legacy API\n\n    Caller-&gt;&gt;MW: API Request (e.g., Get Benefits for Member ID)\n    \n    %% Step 1: Check Token Cache\n    MW-&gt;&gt;Cache: Fetch Downstream Access Token (OAuth Client Credentials)\n    alt Token Exists and is Valid (Cache Hit)\n        Cache--&gt;&gt;MW: Return Valid Token\n    else Token Expired or Missing (Cache Miss)\n        MW-&gt;&gt;Auth: Request New Token (Client Credentials Grant)\n        Auth--&gt;&gt;MW: Return Access Token &amp; Expires_In (e.g., 3600s)\n        MW-&gt;&gt;Cache: Securely Cache Token (TTL = Expires_In - 300s buffer)\n    end\n\n    %% Step 2: Check Data Cache (Pre-fetching Strategy)\n    MW-&gt;&gt;Cache: Check for Cached Member Benefits Data\n    alt Benefits Data Cached (Cache Hit)\n        Cache--&gt;&gt;MW: Return Clean JSON Data\n        MW--&gt;&gt;Caller: Return Standardized JSON Output\n    else Benefits Data Missing (Cache Miss / First-time user)\n        %% Step 3: Call Downstream Legacy API with Valid Token\n        MW-&gt;&gt;Legacy: Call Legacy API (Bearer Token attached)\n        Legacy--&gt;&gt;MW: Return Raw Data Structure / EDI Payload\n        \n        %% Step 4: Transform, Cache, and Respond\n        MW-&gt;&gt;MW: Transform Raw / EDI into Clean JSON DTO\n        MW-&gt;&gt;Cache: Cache Standardized JSON Data (Short TTL, e.g., 15 mins)\n        MW--&gt;&gt;Caller: Return Standardized JSON Output\n    end&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="LVe-4DVXrWpF0vgMP6Wl-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
