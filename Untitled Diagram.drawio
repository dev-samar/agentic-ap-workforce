        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph TD\n    %% Layer Background\n    subgraph LayerBG [Background Layer - ALWAYS VISIBLE]\n        BaseContainer[Intake &amp; Filter Node Container]\n        Gatekeeper[Channel Gatekeeper Decision Diamond]\n        \n        %% Static duplicate buttons to catch clicks when overlays are hidden\n        BtnSecBG[\&quot;[Button Shape] View Blocked Channels&lt;br&gt;(Custom Link: Toggle Layer 2)\&quot;]\n        BtnStateBG[\&quot;[Button Shape] View System State&lt;br&gt;(Custom Link: Toggle Layer 3)\&quot;]\n    end\n\n    %% Layer 1\n    subgraph Layer1 [Layer 1: Allowed Channels - Active Flow]\n        Slack[Slack Bot] --&gt;|Allowed Channel| Gatekeeper\n        Teams[Teams Bot] --&gt;|Allowed Channel| Gatekeeper\n        WhatsApp[WhatsApp API] --&gt;|Allowed Channel| Gatekeeper\n        \n        Gatekeeper --&gt; FileCheck{Is Image/PDF?}\n    end\n\n    %% Layer 2\n    subgraph Layer2 [Layer 2: Security Overlay - HIDDEN BY DEFAULT]\n        Gmail[Gmail Inbox] -.-&gt;|Connection Blocked| Gatekeeper\n        Outlook[Outlook Inbox] -.-&gt;|Connection Blocked| Gatekeeper\n        Unauth[Unauthorized APIs] -.-&gt;|Connection Blocked| Gatekeeper\n        SecurityNotes[Security Compliance Rules Text Box]\n        \n        %% Clickable overlay button directly over the background button\n        BtnSecActive[\&quot;[Button Shape] Hide Blocked Channels&lt;br&gt;(Custom Link: Toggle Layer 2)\&quot;]\n    end\n\n    %% Layer 3\n    subgraph Layer3 [Layer 3: State &amp; Filesystem Overlay - HIDDEN BY DEFAULT]\n        FileCheck --&gt;|Yes: Save File| VFS[(Virtual Filesystem / Scratch)]\n        VFS --&gt;|Write State| StateNode[State: raw_document_path &amp; channel_origin]\n        \n        %% Clickable overlay button directly over the background button\n        BtnStateActive[\&quot;[Button Shape] Hide System State&lt;br&gt;(Custom Link: Toggle Layer 3)\&quot;]\n    end\n\n    %% JSON Custom Link Toggles representing Interactivity\n    BtnSecBG -.-&gt;|data:action/json...| Layer2\n    BtnSecActive -.-&gt;|data:action/json...| Layer2\n    \n    BtnStateBG -.-&gt;|data:action/json...| Layer3\n    BtnStateActive -.-&gt;|data:action/json...| Layer3\n\n    %% Styling\n    classDef bg fill:#fcfcfc,stroke:#333,stroke-width:2px;\n    classDef l1 fill:#e3f2fd,stroke:#1565c0,stroke-width:1px;\n    classDef l2 fill:#ffebee,stroke:#c62828,stroke-width:1px,stroke-dasharray: 5 5;\n    classDef l3 fill:#e8f5e9,stroke:#2e7d32,stroke-width:1px,stroke-dasharray: 5 5;\n    \n    class LayerBG bg;\n    class Layer1 l1;\n    class Layer2 l2;\n    class Layer3 l3;&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="3FnApArYfVNxVUfU3BQo-3">
          <mxCell connectable="0" parent="3FnApArYfVNxVUfU3BQo-2" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
